{
  "name": "dsh-core-memory",
  "version": "1.1.0",
  "description": "Cross-session persistent memory for DeepSeek Harness: OpenClaw-style core memory always injected into every session, plus archival notes with seven model tools and a user-configurable AI reply-style (persona) settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "memory",
    "cross-session",
    "long-term-memory",
    "persona",
    "markdown",
    "dshapp-plugin",
    "dshapp-plugin-featured"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "android": {
      "builtinId": "core-memory"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
