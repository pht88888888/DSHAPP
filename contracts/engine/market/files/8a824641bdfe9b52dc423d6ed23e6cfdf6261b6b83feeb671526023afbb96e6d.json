{
  "name": "@deepseek-ai/dsh-api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "node": "./lib/client.node.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./stream-protocol": {
      "types": "./lib/types/stream-protocol.d.ts",
      "default": "./lib/types/stream-protocol.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.browser.js",
    "lib/client.node.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-deque": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "ws": "^8.21.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-remote-mock": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-crypto": "0.2.2-rc.1",
    "@types/ws": "^8.18.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}