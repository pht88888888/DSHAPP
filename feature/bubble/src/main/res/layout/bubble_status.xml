<?xml version="1.0" encoding="utf-8"?>
<!--
  收起态上方那个状态气泡。

  它是一个**独立的 window**（不是圆形气泡的子 View），原因：
    · 球的 window 尺寸默认 44dp，气泡比它宽得多。塞在一起就得把 window 撑大，
      而 window 左上角是定位锚点 —— 撑大之后球本身的位置会跟着偏，拖动/吸附
      那套坐标计算全要重写。
    · 独立 window 还能单独控制显示时机（空闲时不显示），球本身完全不受影响。

  宽度用 wrap_content + maxWidth 限制在代码里设：状态文字长度不受控
  （"正在运行命令 · sleep 10" 这类），必须有个上限，否则会横贯整个屏幕。

  ⚠️ 外层是**竖直**的 LinearLayout，里面第一行是配图、第二行才是「点 + 文字」。
     这个层级不是装饰：气泡整个摆在球的**正上方**，所以最上面那张图正好落在
     球头顶 —— 与电脑端桌面宠物的观感一致。若把图放进第二行（与文字并排），
     它会出现在球的**侧面**，语义就变了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bubble_status_bg"
    android:elevation="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="7dp"
    android:paddingEnd="10dp"
    android:paddingBottom="7dp">

    <!--
      状态配图（头顶表情包）。默认 GONE —— 没配 `statusImages` 时这个气泡的
      布局与加图之前**逐像素相同**，所以老用户零影响。

      尺寸在代码里按 `statusImageSizeDp` 设（默认 96dp，上限 240dp）：
      不同素材的宽高比不一样，用固定边长 + adjustViewBounds 让长边贴合。
    -->
    <ImageView
        android:id="@+id/statusImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/statusTextRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          小圆点：与球里的状态点同色，让"气泡属于这个球"一眼可辨。
        -->
        <View
            android:id="@+id/statusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#1A1D21"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
