<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：Web 视图（官方 Web GUI）+ 启动过渡层。

  ⚠️ 这里是**空容器**而不是直接写 `<WebView>`：本 App 有两个 Web 内核版本
     （system = 系统 WebView、gecko = 内置 GeckoView），承载控件由
     `WebHostFactory` 在运行期决定（见 com.dsh.android.web.WebHost），
     布局里放不下写死的控件类型。

  启动层的设计意图（配色与图标同源，见 AGENTS.md 的图标一节）：
    · 深色底 + 径向渐变，中心比四周略亮，把视线收到头像上
    · 圆形头像徽章居中，外围旋转光环 + 真实进度环
    · 文案两行：阶段名 + 补充说明，字号/字距克制

  ⚠️ overlay 是**不透明**的，且盖在 Web 视图之上。收尾时必须走淡出动画
     （见 MainActivity.hideOverlay），直接 setVisibility(GONE) 会出现硬切。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/boot_background"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- 只让中间内容滚动：完整错误栈不能把底部原生自救操作挤出屏幕。
                 fillViewport 保留短文案时头像与标题居中的启动视觉。 -->
            <ScrollView
                android:id="@+id/overlayContentScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:paddingBottom="12dp">

                    <!-- 动画主体：头像 + 双层环 -->
                    <com.dsh.android.ui.BootAnimationView
                        android:id="@+id/bootAnim"
                        android:layout_width="190dp"
                        android:layout_height="190dp" />

                    <!-- 应用名。字距拉开，与头像的圆形构成视觉平衡 -->
                    <TextView
                        android:id="@+id/overlayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.32"
                        android:text="@string/app_name"
                        android:textColor="#EAF0FA"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <!-- 阶段名 -->
                    <TextView
                        android:id="@+id/overlayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="准备中…"
                        android:textColor="#8FA3C0"
                        android:textSize="13.5sp" />

                    <!-- 补充说明 / 完整错误详情：随内容增高，由外层 ScrollView 滚动，
                         不截断、不省略栈尾，也不把底部操作纳入滚动范围。 -->
                    <TextView
                        android:id="@+id/overlayHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#5A6B85"
                        android:textSize="11.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/overlayRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/overlay_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:paddingStart="20dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="10dp"
                        android:text="@string/overlay_retry"
                        android:textColor="#DCE6F5"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/overlayShowPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/overlay_show_page"
                        android:textColor="#8FA3C0"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <!-- 原生兜底操作独立占据底部两行；引擎或 Web GUI 失败时仍然可见。
                 等宽按钮允许大字体换行，至少 48dp 触摸高度，不限制行数。 -->
            <LinearLayout
                android:id="@+id/overlayActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/overlayExport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/log_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:letterSpacing="0.06"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:text="@string/overlay_export_entry"
                        android:textColor="#8FA3C0"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/overlayImport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/log_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:letterSpacing="0.06"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:text="@string/overlay_import_entry"
                        android:textColor="#8FA3C0"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/overlayLogs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/log_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:letterSpacing="0.06"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:text="@string/overlay_logs_entry"
                        android:textColor="#8FA3C0"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/overlayRepair"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/log_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:text="@string/overlay_repair_entry"
                        android:textColor="#8FA3C0"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
