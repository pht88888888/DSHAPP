<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 桌面显示名：只写 DSH。仓库名与宣传文案用 dsh-app —— 「App」是描述词，
         放在仓库/宣传里说明「这是 DSH 的安卓客户端」，不适合当应用名。 -->
    <string name="app_name">DSH</string>
    <string name="notification_channel_name">引擎运行中</string>
    <string name="notification_channel_desc">保持本地 AI 引擎在后台运行，并实时显示它当前在做什么</string>
    <string name="notification_engine_running">DSH 引擎正在运行</string>
    <!-- 页面还没上报状态时（引擎刚起、WebView 未加载完）的兜底文案 -->
    <string name="notification_idle">空闲</string>
    <string name="notification_thinking">正在思考</string>
    <string name="notification_no_content">暂无内容</string>

    <!-- 无线调试配对（Android 11+）。流程与文案参考 Shizuku 的 AdbPairingService。 -->
    <!--
      点了配对、但还没发现配对端口时的提示。

      ⚠️ 文案必须**指导动作**，不能是「没找到，请重来」。用户此刻正在系统设置里
      翻找那个界面，给一个失败结论只会让人以为要回 App 重按一次 —— 而重按一次
      还是同样的结果，因为端口本来就还没出现。真机反馈过这个来回。
    -->
    <!--
      配对超时（真机反馈修掉的缺陷）。

      ⚠️ 原实现这一路**没有任何超时**：用户输入配对码后通知栏一直停在「正在配对」，
      直到系统弹「DSH 没有响应」，永远拿不到结论。这条文案就是那个终态结论，
      必须同时说清「为什么没成」和「下一步做什么」，不能只说「失败」。
    -->
    <!--
      配对过程抛出异常时的兜底文案（没有任何可用 message 时用这句）。

      ⚠️ 必须有这一条：原实现失败分支直接读 `result.message`，而异常路径里
      `result` 根本不存在 —— 那种写法在真机上会崩，表现正是「通知永远停在正在配对」。
    -->
    <!--
      进程重启后清理残留配对状态时的提示（真机反馈：App 被 ANR 杀掉重开后，
      通知栏还挂着「正在配对」，而权限其实已经开了）。
    -->
    <!-- 悬浮气泡收起态的头像（与 App 图标同一个角色）。纯装饰，无障碍描述写清用途即可。 -->

    <!--
      失败浮层上的「安全模式」按钮。

      ⚠️ 文案刻意写清「不丢会话」：这一步会推开用户的插件配置（改名备份，不删），
      代价必须让用户看得见才敢点。
    -->
    <string name="safe_mode_entry">进入安全模式（不改动会话与凭据）</string>

    <!--
      降级态常驻横幅上的两个按钮（方案 §4.4.5，不变量 I4）。

      「退出」做的是把层级复位成 NORMAL 并重启（不是删数据）；「详情」把
      state.json 里的原因摆出来给用户看。两个都刻意短 —— 横幅上横向放得下。
    -->
    <string name="rescue_banner_exit">退出并重试</string>
    <string name="rescue_banner_detail">上次为什么失败</string>

    <!--
      启动层上的「导出数据」「导入数据」按钮。

      ## 为什么必须在启动层、且任何状态都显示

      用户最需要它们的时刻恰恰是「引擎已经挂了、界面打不开」——那时候
      设置页（在 Web GUI 里）根本进不去。而卸载重装会清掉整个私有目录，
      所以「先导出再卸载」是唯一不丢数据的自救路径。

      与「查看日志」同一套理由（见 overlayLogs 的注释），但更重要：
      日志只是诊断，数据是用户真正在乎的东西。
    -->
    <string name="overlay_export_entry">导出数据</string>
    <string name="overlay_import_entry">导入数据</string>

    <!-- 导出/导入对话框 -->
    <string name="backup_export_title">导出数据</string>
    <string name="backup_export_hint">勾选要导出的内容。不含引擎本身（重装时会自动解包）。</string>
    <string name="backup_import_title">导入数据</string>
    <string name="backup_import_hint">选择一份备份，勾选要恢复的内容。恢复前会自动备份现有数据。</string>
    <string name="backup_import_pick">选择备份文件…</string>
    <string name="backup_import_empty">没有找到备份。请先把 dsh-backup-*.zip 放到手机的「下载」目录。</string>
    <string name="backup_do_export">导出到手机</string>
    <string name="backup_do_import">开始恢复</string>
    <string name="backup_cancel">取消</string>
    <string name="backup_working">处理中…</string>
    <string name="backup_risky_hint">含明文密钥，导出后任何 App 都能读取</string>

    <!--
      Shizuku 相关文案（设置页「特权权限」分节）。

      Shizuku 是 uid 2000 的第二条来源，也是**唯一不依赖 adbd** 的那条：它不需要
      设备上的 5555 在监听、不需要无线调试、也不校验我们的 adbkey。对 Android 10
      及以下（没有无线调试，且每次重启都要电脑再跑一次 `adb tcpip 5555`）的用户，
      这往往是唯一可行的路。
    -->
    <string name="shizuku_need_service">Shizuku 服务没有运行，无法弹出授权界面。请先打开 Shizuku 应用并启动服务，再回来点「授权」。</string>

    <!--
      键盘哨兵（无障碍服务）。

      ⚠️ 无障碍设置的列表里**只会显示 label**，而系统设置页的说明文字就是
      description —— 用户在这里决定要不要把一个「能看屏幕的无障碍服务」打开，
      所以两段文案都必须讲清「为什么需要」和「不会看什么」，不能只写一句
      「提升体验」。这是权限申请，不是文案装饰。
    -->
</resources>
