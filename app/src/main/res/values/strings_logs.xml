    <string name="logs_plugins">Plugins</string>

    <!--
      ══ 插件开关（App 打不开时的自救）══════════════════════════════════════

      ⚠️ 这一组文案的读者是「界面已经打不开、正着急的用户」，所以必须：
      ① 说清**摘掉插件不会丢数据**（他最怕的是这个）；
      ② 说清**为什么值得摘**（进去之后才能让 AI 修）；
      ③ 不用「bundle」这类内部词，除非同时给出人话解释。
    -->
    <string name="logs_plugins_title">Plugins (%1$d)</string>
    <string name="logs_plugins_apply">Apply</string>
    <string name="logs_plugins_none">No third-party plugins installed.\n\nIf the interface still won\'t open, plugins are not the cause. Please send a diagnostic bundle to the developer.</string>
    <string name="logs_plugins_unreadable">Cannot read the plugin list (profiles/web/package.json is invalid JSON or missing).\n\nThis commonly prevents the interface from opening. Ask the AI to repair it in a chat. If you cannot open a chat, send a diagnostic bundle to the developer.</string>
    <string name="logs_plugins_failed">Could not apply changes</string>
    <string name="logs_plugins_unchanged">No changes</string>
    <string name="logs_plugins_restart_title">Restart required</string>
    <string name="logs_plugins_restart_msg">Changed %1$d plugins.\n\nRestart to apply (about 10–20 seconds). Your sessions, credentials, and workspace will be kept.</string>
    <string name="logs_plugins_restart_now">Restart now</string>
    <string name="logs_plugins_restarting">Restarting…</string>
    <string name="logs_plugins_restart_failed">Restart failed: %1$s</string>

    <!--
      空态文案。

      ⚠️ 刻意给一句**可执行**的话而不是「暂无数据」：用户在这个界面看到空白时
      会以为功能坏了。说清「什么情况下才会有内容」，并提示他能做什么。
    -->
    <string name="logs_empty">No logs yet.\n\nEngine startup, plugin loading, and crash details appear here.\nIf you just restarted the app, wait a few seconds and tap Refresh.</string>

    <!-- 清空前的确认 -->
    <string name="logs_clear_confirm">Clear logs?\n\nSaved logs and crash details will be permanently deleted.\n(The running app will keep recording new logs)</string>
    <string name="logs_cleared">Logs cleared</string>
    <string name="logs_copied">Copied %1$d log lines</string>
    <string name="logs_copy_failed">Copy failed: %1$s</string>
    <string name="logs_exporting">Creating diagnostic bundle…</string>
    <string name="logs_export_ok">Diagnostic bundle saved:\n%1$s</string>
    <string name="logs_export_failed">Could not create diagnostic bundle: %1$s</string>
    <string name="logs_uploading">Uploading diagnostic bundle…</string>
    <string name="logs_upload_progress">Uploading (%1$d pending)…</string>
    <string name="logs_no_pending">No diagnostic bundles pending upload</string>

    <!-- 浮层上的日志入口。⚠️ 文案必须常驻可见，不能只在失败态出现（见 MainActivity） -->
    <string name="overlay_logs_entry">View logs</string>

    <!-- 设置页里的日志入口 -->
    <string name="settings_logs_entry">Logs and diagnostics</string>
