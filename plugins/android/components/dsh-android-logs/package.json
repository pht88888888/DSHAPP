{
  "name": "dsh-android-logs",
  "version": "1.1.0",
  "description": "DSH Android 客户端的日志工具：把「读运行日志 / 看崩溃现场 / 生成诊断包」暴露成一个独立工具，让模型自己查日志而不是靠猜。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "android": {
      "builtinId": "logs-tool"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
