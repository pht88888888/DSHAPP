{
  "name": "dsh-android-root",
  "version": "1.1.0",
  "description": "DSH Android 客户端的 root（uid 0）特权执行工具：把「经 su 以 root 身份跑命令」暴露成一个独立工具，由模型按需选择。仅在宿主探测到确实能提权时才会被挂载。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "android": {
      "builtinId": "root-tool"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
