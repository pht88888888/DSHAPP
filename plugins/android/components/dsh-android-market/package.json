{
  "name": "dsh-android-market",
  "version": "1.1.0",
  "description": "DSH Android 插件市场：从 npm 按关键词收录插件（社区区 + 人工审核的精选区），在设置里浏览、搜索、一键安装，并对原生依赖给出 Android 兼容性警告。",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test test/market.mjs",
    "test:engine": "node test/real-engine.mjs"
  },
  "devDependencies": {
    "zod": "4.4.3"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./collect": {
      "default": "./lib/collect.mjs"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "android": {
      "builtinId": "market"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
