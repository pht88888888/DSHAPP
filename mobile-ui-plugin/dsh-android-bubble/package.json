{
  "name": "dsh-android-bubble",
  "version": "1.1.0",
  "description": "DSH Android 客户端的悬浮球控制工具：把「改悬浮窗的状态/大小/形状/配色/头像」暴露成一个独立工具，让模型像改自己的 web 界面一样改悬浮窗。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "android": {
      "builtinId": "bubble-tool"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
